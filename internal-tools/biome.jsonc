{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.json",
      "!dist",
      "!public",
      "!package-lock.json",
      // Vendorovaný shadcn kód generovaný CLI. Ruční opravy by se při dalším
      // "shadcn add" přepsaly, takže se nelintuje.
      "!src/components/ui"
    ]
  },
  "javascript": {
    "jsxRuntime": "transparent"
  },
  /*
   * Formátování ZÁMĚRNĚ zůstává na prettieru. Biome formatter neumí to, co
   * prettier-plugin-tailwindcss — tedy řadit tailwind classy. Kdyby tu byl
   * zapnutý, oba nástroje by si přepisovaly soubory navzájem.
   */
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      /*
       * Tenhle projekt je starší než `admin` a `editor` a biome na něm po
       * přechodu z eslintu našel ~30 věcí, které předchozí konfigurace
       * nehlídala. Nejsou to chyby zavlečené teď, takže zůstávají jako "warn"
       * a dají se dočistit postupně — build ani lint na nich neselže.
       *
       * Až budou opravené, smaž tenhle blok a projekt bude na stejně striktním
       * nastavení jako `admin` a `editor`.
       */
      "a11y": {
        // Chybí type="button" u ~12 tlačítek. Bez něj tlačítko ve <form>
        // odešle formulář.
        "useButtonType": "warn",
        // <label> bez vazby na input (TradingResults).
        "noLabelWithoutControl": "warn",
        "noSvgWithoutTitle": "warn",
        "useKeyWithClickEvents": "warn",
        "noStaticElementInteractions": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        // parseInt() bez radixu na 7 místech ve FearGrid.
        "useParseIntRadix": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn"
      },
      "complexity": {
        "noUselessFragments": "warn"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "warn",
        "noNonNullAssertion": "warn",
        "useComponentExportOnlyModules": "warn"
      }
    }
  }
}
