RewriteEngine On
RewriteBase /

# 1. Kanonické přesměrování na HTTPS a bez www (301)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,NE,R=301]

# 2. Existující soubory a složky se doručují přímo (statické assety, obrázky, atd.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Požadavky na sub-aplikace (/admin, /editor, /internal) se nepřepisují na hlavní index.html.
# Každá podaplikace má vlastní .htaccess ve své podsložce a obsluhuje vlastní SPA routing.
RewriteCond %{REQUEST_URI} ^/(admin|editor|internal) [NC]
RewriteRule ^ - [L]

# 3. Veškeré ostatní routy hlavního webu spadnou na index.html (SPA fallback)
RewriteRule ^ index.html [L]

# 4. Cache. Rozhoduje se podle cesty, ne podle přípony: hash v názvu dává jen
# Vite do /assets/. Soubory z public/ (favicon.ico, SB-badge.ico,
# fallback-coin.png, robots.txt, sitemap.xml) leží v kořeni pod stálým jménem,
# takže by je "immutable" zamklo návštěvníkům v cache na rok i po změně.
#
# Pravidla se vyhodnocují v pořadí, poslední zapsaná hlavička vyhrává.
# Obojí je zanořené schválně: neznámá direktiva v .htaccess shodí celý web na
# 500, takže se bez některého z modulů radši neudělá nic.
<IfModule mod_headers.c>
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/assets/" SB_HASHED
  SetEnvIf Request_URI "\.(png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|otf|eot|mp4|webm)$" SB_STATIC

  # Výchozí stav: index.html i všechny SPA routy se musí revalidovat, jinak by
  # si prohlížeč držel odkazy na staré, už smazané chunky.
  Header set Cache-Control "no-cache, must-revalidate"

  # Statické soubory bez hashe — den, ať se změna projeví v rozumném čase.
  Header set Cache-Control "public, max-age=86400" env=SB_STATIC

  # /assets/* — při změně obsahu se mění i URL, může se cachovat natrvalo.
  Header set Cache-Control "public, max-age=31536000, immutable" env=SB_HASHED
</IfModule>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>
