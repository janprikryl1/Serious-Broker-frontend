{
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended"
  ],
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx"
      ]
    },
    {
      "files": [
        "src/generated-types/**/*"
      ],
      "rules": {
        "react/no-unescaped-entities": "off",
        "comma-dangle": "off",
        "indent": "off",
        "semi": "off",
        "quotes": "off"
      }
    }
  ],
  "ignorePatterns": [
    "src/generated-types/**/*"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "react",
    "@typescript-eslint"
  ],
  "rules": {
    "react/no-unescaped-entities": [
      "warn",
      {
        "forbid": [
          ">",
          "}"
        ]
      }
    ],
    "comma-dangle": [
      "warn",
      {
        "arrays": "never",
        "objects": "never",
        "imports": "never",
        "exports": "never",
        "functions": "never"
      }
    ],
    "indent": [
      "warn",
      2
    ],
    "semi": [
      "warn",
      "always"
    ],
    "quotes": [
      "warn",
      "single"
    ],
    "object-curly-spacing": [
      "warn",
      "always"
    ]
  }
}